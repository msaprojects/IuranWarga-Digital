@startuml
'https://plantuml.com/activity-diagram-beta

start
:Petugas Register Organisasi;
if (Cek Kode Organisasi ) then (yes)
  :Organisasi Berhasil Dibuat;
else (no)
  stop
endif
:Petugas Menambahkan Data Warga/Rumah Tangga;
:Petugas Menambahkan Data User;
:Petugas Membuat Sub-Org;
:Petugas Menambahkan Anggota Sub-Org;
:Petugas Menentukan Anggota Petugas;
:Petugas Membuat Tagihan;
:Petugas Scan Kode Anggota;
if(Ada Tagihan?) then (yes)
  :Kalkulasi Tagihan;
  if(Nominal Sama?) then (yes)
    :Pembayaran Berhasil;
  else (no)
    if(Lebih Besar?) then(yes)
      :Buat Deposit Untuk Tagihan Selanjutnya;
    else (no)
      :Pembayaran Kurang, Ditambahkan Di Tagihan Selanjutnya;
    endif
  endif
else (no)
  stop
endif
stop

@enduml
