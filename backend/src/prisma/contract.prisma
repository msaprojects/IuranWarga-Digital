// use prisma-8

// ============================================================
// ATURAN NORMALISASI
// 1. organisasi = tenant root. Tabel transaksional menyimpan organisasi_id
//    sebagai tenant key (denormalisasi sengaja) agar filter & isolasi data
//    tidak perlu join berlapis.
// 2. Setiap FK wajib punya index (PostgreSQL tidak membuat index FK otomatis).
// 3. Model penghubung wajib punya @@unique atas pasangan FK-nya, agar relasi
//    many-to-many tidak bisa duplikat.
// 4. Riwayat pembayaran bersifat append-only: koreksi lewat pembayaran baru,
//    bukan update nominal/status.
// 5. updatedAt di-maintain di service layer; dialect contract ini tidak
//    mendukung @updatedAt.
// ============================================================

// ============================================================
// ORGANISASI
// ============================================================

model organisasi {
  id       Int     @id @default(autoincrement())
  kode     String  @unique
  nama     String
  alamat   String?
  website  String?
  isActive Boolean @default(true)
  email    String? @unique
  contact  String?

  createdAt TimestamptzString  @default(now())
  updatedAt TimestamptzString  @default(now())
  activeAt  TimestamptzString?

  // Relations
  users              user[]
  peserta            peserta[]
  jenis_iuran        jenis_iuran[]
  tagihan_iuran      tagihan_iuran[]
  pembayaran         pembayaran_iuran[]
  keuangan           keuangan[]
  transaction_ledger transaction_ledger[]
  sub_organisasi     sub_organisasi[]

  @@index([nama])
}

// ============================================================
// SUB ORGANISASI
// Tambahan 10-11-2026
// Alasan: Dalam suatu organisasi kemasyarakatan, terkadang ada sub-organisasi yang terkait dengan organisasi utama, seperti:
// PKK
// Pengajian
// ============================================================

model sub_organisasi {
  id            Int               @id @default(autoincrement())
  nama          String
  deskripsi     String?
  isActive      Boolean           @default(true)
  pisah_laporan Boolean           @default(false)

  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // Ketua / penanggung jawab TIDAK disimpan di sini: satu sumber kebenaran
  // ada di pengurus_sub_organisasi lewat kolom jabatan.
  anggota_sub_organisasi   anggota_sub_organisasi[]
  pengurus_sub_organisasi  pengurus_sub_organisasi[]
  komponen_sub_organisasi  komponen_sub_organisasi[]
  tagihan_iuran            tagihan_iuran[]
  transaction_ledger       transaction_ledger[]

  @@unique([organisasi_id, nama])
  @@index([organisasi_id])
  @@index([isActive])
}

// ============================================================
// Anggota sub_organisasi
// ============================================================
model anggota_sub_organisasi {
  id                Int               @id @default(autoincrement())
  sub_organisasi_id Int
  sub_organisasi    sub_organisasi    @relation(fields: [sub_organisasi_id], references: [id])
  peserta_id        Int
  peserta           peserta           @relation(fields: [peserta_id], references: [id])
  isActive          Boolean           @default(true)
  createdAt         TimestamptzString @default(now())
  updatedAt         TimestamptzString @default(now())

  // Satu peserta hanya boleh terdaftar sekali per sub-organisasi.
  @@unique([sub_organisasi_id, peserta_id])
  @@index([sub_organisasi_id])
  @@index([peserta_id])
}

// ============================================================
// Pengurus Sub Organisasi
// ============================================================

model pengurus_sub_organisasi {
  id                Int               @id @default(autoincrement())
  sub_organisasi_id Int
  sub_organisasi    sub_organisasi    @relation(fields: [sub_organisasi_id], references: [id])
  user_id           Int
  user              user              @relation(fields: [user_id], references: [id])
  // Jabatan dalam sub-organisasi, mis. KETUA / SEKRETARIS / BENDAHARA.
  jabatan           String
  isActive          Boolean           @default(true)
  createdAt         TimestamptzString @default(now())
  updatedAt         TimestamptzString @default(now())

  // Satu user hanya punya satu jabatan aktif per sub-organisasi.
  @@unique([sub_organisasi_id, user_id])
  @@index([sub_organisasi_id])
  @@index([user_id])
}

// ============================================================
// KOMPONEN IURAN SUB ORGANISASI
//
// Override tarif jenis_iuran khusus sub-organisasi.
// Nama model sengaja dipendekkan (bukan komponen_tagihan_sub_organisasi)
// agar nama constraint unik (sub_organisasi_id, jenis_iuran_id) tetap
// di bawah batas 63 byte identifier PostgreSQL.
// ============================================================
model komponen_sub_organisasi {
  id                  Int               @id @default(autoincrement())
  sub_organisasi_id   Int
  sub_organisasi      sub_organisasi    @relation(fields: [sub_organisasi_id], references: [id])
  jenis_iuran_id      Int
  jenis_iuran         jenis_iuran       @relation(fields: [jenis_iuran_id], references: [id])
  // Override tarif jenis_iuran khusus sub-organisasi ini.
  // Bukan salinan jenis_iuran.nominal; simpan hanya bila berbeda.
  nominal             Decimal
  isActive            Boolean           @default(true)
  createdAt           TimestamptzString @default(now())
  updatedAt           TimestamptzString @default(now())

  // Satu jenis iuran hanya boleh dikonfigurasi sekali per sub-organisasi.
  @@unique([sub_organisasi_id, jenis_iuran_id])
  @@index([sub_organisasi_id])
  @@index([jenis_iuran_id])
}

// ============================================================
// USER
// ============================================================

model user {
  id       Int     @id @default(autoincrement())
  username String  @unique
  name     String?
  password String
  role     Role
  isActive Boolean @default(true)
  email    String? @unique
  contact  String? @unique

  // Nullable:
  // null = user tidak terikat ke organisasi tertentu
  organisasi_id Int?
  organisasi    organisasi? @relation(fields: [organisasi_id], references: [id])

  latestLogin TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // Relations
  peserta                 peserta[]
  pembayaran_iuran        pembayaran_iuran[]
  keuangan                keuangan[]
  transaction_ledger      transaction_ledger[]
  pengurus_sub_organisasi pengurus_sub_organisasi[]
  // Tagihan yang di-soft-delete oleh user ini (audit trail).
  tagihan_iuran_dihapus tagihan_iuran[]

  @@index([organisasi_id])
  @@index([role])
}

// ============================================================
// PESERTA / RUMAH
//
// Satu peserta = satu rumah / unit pembayar iuran.
// detail_peserta = anggota keluarga yang tinggal di rumah / ikut organisasi tersebut.
// ============================================================

model peserta {
  id Int @id @default(autoincrement())

  // Kode internal peserta.
  // Unik hanya di dalam satu organisasi.
  kode String

  nama        String?
  nomor_rumah String?
  alamat      String?
  deskripsi   String?

  jenis_peserta JenisPeserta

  // Token yang digunakan untuk QR Code.
  // Jangan simpan NIK/KK/nama langsung sebagai isi QR.
  qr_token String? @unique
  qr_path  String?

  isActive Boolean @default(true)

  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  // User yang memiliki akses terhadap rumah/peserta.
  // Nullable karena tidak semua rumah harus memiliki akun.
  user_id Int?
  user    user? @relation(fields: [user_id], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // Relations
  anggota_keluarga       detail_peserta[]
  tagihan_iuran          tagihan_iuran[]
  pembayaran             pembayaran_iuran[]
  anggota_sub_organisasi anggota_sub_organisasi[]

  @@unique([organisasi_id, kode])
  @@index([organisasi_id])
  @@index([nomor_rumah])
  @@index([user_id])
  @@index([isActive])
}

// ============================================================
// DETAIL PESERTA / ANGGOTA KELUARGA
// ============================================================

model detail_peserta {
  id Int @id @default(autoincrement())

  peserta_id Int
  peserta    peserta @relation(fields: [peserta_id], references: [id])

  nama            String
  status_keluarga StatusKeluarga

  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@index([peserta_id])
  @@index([isActive])
}

// ============================================================
// JENIS IURAN
//
// Contoh:
// - Iuran Kebersihan
// - Iuran Keamanan
// - Iuran RT
// - Iuran Sampah
// ============================================================

model jenis_iuran {
  id Int @id @default(autoincrement())

  // Master tarif selalu milik satu organisasi (tidak boleh lintas tenant).
  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  judul         String
  periode_iuran PeriodeIuran

  nominal Decimal

  jenis_peserta JenisPeserta

  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // Relations
  tagihan_iuran           tagihan_iuran[]
  komponen_sub_organisasi komponen_sub_organisasi[]

  // Nama iuran unik di dalam satu organisasi.
  @@unique([organisasi_id, judul])
  @@index([organisasi_id])
  @@index([isActive])
  @@index([periode_iuran])
}

// ============================================================
// TAGIHAN IURAN
//
// Tagihan dibuat terlebih dahulu.
// Pembayaran terjadi terhadap tagihan.
//
// Contoh:
//
// Tagihan Januari = Rp50.000
//
// Payment 1 = Rp20.000
// Payment 2 = Rp30.000
//
// Status tagihan kemudian menjadi SUDAH_BAYAR.
// ============================================================

model tagihan_iuran {
  id Int @id @default(autoincrement())

  // Nomor tagihan yang bisa ditampilkan kepada user.
  nomor_tagihan String @unique

  // Tenant key: denormalisasi sengaja dari peserta agar filter per
  // organisasi tidak perlu join berlapis.
  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  // Iuran yang ditagihkan pada periode ini.
  jenis_iuran_id Int
  jenis_iuran    jenis_iuran @relation(fields: [jenis_iuran_id], references: [id])

  // Opsional: tagihan khusus sub-organisasi (mis. PKK / pengajian).
  sub_organisasi_id Int?
  sub_organisasi    sub_organisasi? @relation(fields: [sub_organisasi_id], references: [id])

  peserta_id Int
  peserta    peserta @relation(fields: [peserta_id], references: [id])

  // Periode tagihan.
  // bulan null hanya valid untuk periode non-bulanan (HARIAN/MINGGUAN/TAHUNAN).
  tahun Int
  bulan Int?

  tanggal_terbit Date

  // Nominal yang wajib dibayar.
  nominal_tagihan Decimal

  status StatusTagihan

  keterangan String?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // misal: peserta pindah rumah, tagihan dibatalkan atau alasan lainnya.
  deletedAt          TimestamptzString?
  deletedBy          Int?
  deleted_by         user? @relation(fields: [deletedBy], references: [id])
  deletedDescription String?

  // Relations
  pembayaran pembayaran_iuran[]

  @@unique([peserta_id, jenis_iuran_id, tahun, bulan])
  @@index([organisasi_id, tahun, bulan])
  @@index([organisasi_id, status])
  @@index([jenis_iuran_id])
  @@index([peserta_id])
  @@index([sub_organisasi_id])
  @@index([deletedAt])
}

// ============================================================
// PEMBAYARAN IURAN
//
// Satu tagihan dapat memiliki lebih dari satu pembayaran.
// Cocok untuk:
// - pembayaran penuh
// - pembayaran cicilan / partial
// - pembayaran ulang
// ============================================================

model pembayaran_iuran {
  id Int @id @default(autoincrement())

  nomor_transaksi String @unique

  // Tenant key, disalin dari tagihan agar laporan kas per organisasi
  // tidak perlu join berlapis.
  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  tagihan_iuran_id Int
  tagihan_iuran    tagihan_iuran @relation(fields: [tagihan_iuran_id], references: [id])

  // Snapshot relasi agar histori transaksi tetap mudah
  // ditelusuri tanpa harus bergantung pada perubahan data master.
  jenis_iuran_id Int
  jenis_iuran    jenis_iuran @relation(fields: [jenis_iuran_id], references: [id])

  peserta_id Int
  peserta    peserta @relation(fields: [peserta_id], references: [id])

  nominal_bayar Decimal

  tanggal_bayar Date

  status StatusPembayaran

  // Waktu transaksi dibuat / dicatat.
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // User yang mencatat pembayaran.
  // Nullable untuk transaksi yang berasal dari sistem otomatis.
  user_id Int?
  user    user? @relation(fields: [user_id], references: [id])

  // Waktu transaksi diposting ke buku keuangan.
  // null = belum diposting.
  postedAt TimestamptzString?

  // Relations
  keuangan_detail keuangan_detail[]

  @@index([organisasi_id])
  @@index([tagihan_iuran_id])
  @@index([jenis_iuran_id])
  @@index([peserta_id])
  @@index([user_id])
  @@index([tanggal_bayar])
  @@index([status])
}

// ============================================================
// KEUANGAN
//
// Buku transaksi keuangan organisasi.
//
// Contoh:
// PEMASUKAN:
// - Pembayaran iuran
//
// PENGELUARAN:
// - Beli alat kebersihan
// - Biaya operasional
// ============================================================

model keuangan {
  id Int @id @default(autoincrement())

  organisasi_id Int
  organisasi    organisasi @relation(fields: [organisasi_id], references: [id])

  tanggal Date

  user_id Int?
  user    user? @relation(fields: [user_id], references: [id])

  keterangan String?

  jenis_keuangan JenisKeuangan

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  // Relations
  detail             keuangan_detail[]
  transaction_ledger transaction_ledger[]

  @@index([organisasi_id])
  @@index([tanggal])
  @@index([jenis_keuangan])
  @@index([user_id])
}

// ============================================================
// DETAIL KEUANGAN
//
// Digunakan untuk menghubungkan transaksi keuangan dengan
// sumber transaksi.
//
// pembayaran_iuran_id nullable:
// null = transaksi keuangan umum
// ada  = transaksi berasal dari pembayaran iuran
// ============================================================

model keuangan_detail {
  id Int @id @default(autoincrement())

  keuangan_id Int
  keuangan    keuangan @relation(fields: [keuangan_id], references: [id])

  nominal Decimal

  pembayaran_iuran_id Int?
  pembayaran_iuran    pembayaran_iuran? @relation(fields: [pembayaran_iuran_id], references: [id])

  keterangan String?

  createdAt TimestamptzString  @default(now())
  updatedAt TimestamptzString  @default(now())
  deletedAt TimestamptzString?

  @@index([keuangan_id])
  @@index([pembayaran_iuran_id])
}

// ============================================================
// TRANSACTION LEDGER
//
// Satu baris = satu kaki (debit/kredit) dari satu jurnal keuangan.
// Baris ledger bersifat append-only: koreksi dilakukan dengan baris balik
// (reversal), bukan update / delete.
// ============================================================
model transaction_ledger {
  id                String          @id @default(uuid(7))
  keuangan_id       Int
  keuangan          keuangan        @relation(fields: [keuangan_id], references: [id])
  organisasi_id     Int
  organisasi        organisasi      @relation(fields: [organisasi_id], references: [id])
  // Nullable: entri otomatis oleh sistem tidak punya aktor user.
  user_id           Int?
  user              user?           @relation(fields: [user_id], references: [id])
  sub_organisasi_id Int?
  sub_organisasi    sub_organisasi? @relation(fields: [sub_organisasi_id], references: [id])

  nominal        Decimal
  tipe           LedgerSign
  system_details String?

  createdAt TimestamptzString @default(now())

  @@index([keuangan_id])
  @@index([organisasi_id, createdAt])
  @@index([user_id])
  @@index([sub_organisasi_id])
}

// ============================================================
// ENUM
// ============================================================

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PeriodeIuran {
  HARIAN
  MINGGUAN
  BULANAN
  TAHUNAN
}

enum StatusTagihan {
  BELUM_BAYAR
  PARTIAL
  SUDAH_BAYAR
  OVERDUE
  CANCELLED
}

enum StatusPembayaran {
  BERHASIL
  CANCELLED
  REFUNDED
}

enum StatusKeluarga {
  KEPALA_KELUARGA
  SUAMI
  ISTRI
  ANAK
  ORANG_TUA
  LAINNYA
}

enum JenisKeuangan {
  PEMASUKAN
  PENGELUARAN
}

enum LedgerSign {
  DEBIT
  KREDIT
}

enum JenisPeserta {
  RUMAH
  KOS
  TEMPAT_USAHA
  LAINNYA
}
